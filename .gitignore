!.yarn/plugins
!.yarn/releases
!.yarn/versions

# === testing ===
/coverage

# === Next.js ===
/.next/
/out/
next-env.d.ts

# === production builds ===
/build

# === misc OS / editor ===
.DS_Store
*.pem
Thumbs.db
*.swp
*.swo
*~

